{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api-server",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
    "issues": {
      "enabled": true,
    },
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/v1/*", "/docs/*"],
  },
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "vars": {
    "LOG_LEVEL": "info"
  },
  "d1_databases": [
    {
      "binding": "SHARE_DB",
      "database_name": "share",
      "database_id": "966e4373-44da-4c7c-8f6a-07695584f426"
    },
    {
      "binding": "WISHES_DB",
      "database_name": "wishes",
      "database_id": "49551e3d-849b-4b6c-838a-74f08dff0d30"
    }
  ],
}
