{
  "default_timeout": 3000,
  "retry_count": 3,
  "cache_ttl": 86400,
  "ip_headers": [
    {
      "name": "X-Forwarded-For",
      "priority": 1
    },
    {
      "name": "x-real-ip",
      "priority": 2
    },
    {
      "name": "x-client-ip",
      "priority": 3
    },
    {
      "name": "cf-connecting-ip",
      "priority": 4
    },
    {
      "name": "x-forwarded",
      "priority": 5
    },
    {
      "name": "forwarded-for",
      "priority": 6
    },
    {
      "name": "forwarded",
      "priority": 7
    }
  ],
  "response_fields": [
    "ip",
    "prov",
    "city",
    "district",
    "country",
    "country_code",
    "isp",
    "lon",
    "lat"
  ],
  "upstream_apis": [
    {
      "name": "ip-api",
      "url": "http://ip-api.com/json/{ip}?lang=zh-CN&fields=status,message,country,countryCode,regionName,city,isp,lat,lon",
      "max_requests": 40,
      "time_window": 60,
      "enabled": true,
      "ip_versions": "IPv6",
      "field_mapping": {
        "ip": "{ip}",
        "prov": "regionName",
        "city": "city",
        "country": "country",
        "country_code": "countryCode",
        "isp": "isp",
        "lon": "lon",
        "lat": "lat"
      }
    },
    {
      "name": "ip9",
      "url": "https://ip9.com.cn/get?ip={ip}",
      "max_requests": 50,
      "time_window": 60,
      "enabled": true,
      "ip_versions": "IPv6,IPv4",
      "field_mapping": {
        "ip": "data.ip",
        "prov": "data.prov",
        "city": "data.city",
        "country": "data.country",
        "country_code": "country_code",
        "isp": "data.isp",
        "lon": "data.lng",
        "lat": "data.lat"
      }
    }
  ]
}