{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api-server",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": ["/v1/*"]
  },
  "vars": {
    "LOG_LEVEL": "info"
  }
}
